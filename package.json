{
  "name": "killmyport",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "End port conflicts in one click",
  "author": "Sheeraz Mehboob <sherazmehboob14@gmail.com>",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "dev:admin": "sudo -E env \"PATH=$PATH\" vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "vite --mode electron",
    "electron:build": "npm run build && electron-builder -p always",
    "package:linux": "npm run build && electron-builder --linux -p always",
    "package:win": "npm run build && electron-builder --win -p always",
    "package:mac": "npm run build && electron-builder --mac -p always",
    "package:all": "npm run build && electron-builder -mwl -p always"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "electron": "^40.10.6",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
